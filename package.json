{
  "name": "thryftly",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k --restart-tries 10 --restart-after 1500 -n api,web \"node --watch server/index.js --port=3000\" vite",
    "dev:api": "node --watch server/index.js --port=3000",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "check": "node server/check.js && node server/check-supabase.js",
    "build:netlify": "vite build && node tools/netlify-redirects.js",
    "push:supabase": "node tools/push-to-supabase.js",
    "setup:auth": "node tools/setup-supabase-auth.js",
    "copy:supabase": "node tools/copy-supabase.js"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "gsap": "^3.12.5",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "nodemailer": "^6.10.1",
    "serverless-http": "^3.2.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.5",
    "vite": "^5.4.0"
  },
  "engines": {
    "node": ">=20.12"
  }
}
