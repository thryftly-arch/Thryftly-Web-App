# Copy to .env and fill in. Never commit .env.
NODE_ENV=production
PORT=3000
DATA_DIR=./data

# Data: leave both empty to keep everything in DATA_DIR on this machine. Set both to use Supabase
# (required on Netlify). See README → "Deploy on Netlify + Supabase".
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Public key (sb_publishable_…): customer sign-in. Leave empty to hide accounts.
SUPABASE_PUBLISHABLE_KEY=

# Emails from the shop's own address. Gmail: SMTP_USER=thryftly@gmail.com, SMTP_PASS=a Google App Password.
SMTP_USER=
SMTP_PASS=
MAIL_FROM=THRYFTLY <thryftly@gmail.com>
# Where new-order and contact-form alerts go (default: SMTP_USER)
OWNER_EMAIL=
# Only for a provider other than Gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# Local only (never on Netlify): lets "npm run setup:auth" configure Supabase Auth. supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=
# On a server you run yourself: 1 = run the hourly shipping-email / cart-reminder job (Netlify runs it for you)
RUN_JOBS=

# Admin panel (/admin)
ADMIN_PASSWORD=change-me-to-something-long
# Random 64+ chars, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Qikink fulfilment. Sandbox: https://sandbox.qikink.com  Live: https://api.qikink.com
QIKINK_BASE_URL=https://sandbox.qikink.com
QIKINK_CLIENT_ID=
QIKINK_CLIENT_SECRET=

# Razorpay payments (test keys start with rzp_test_). Dashboard > Settings > API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard > Webhooks: URL https://your-domain/api/webhooks/razorpay, events payment.captured + order.paid
RAZORPAY_WEBHOOK_SECRET=

# Local AI stylist for try-on (any Ollama vision model)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b

# Qikink "Push to store" via its WooCommerce connection (see docs/qikink-woocommerce.md)
# Public https address of this site, no trailing slash. Qikink knows the store by this URL.
SITE_URL=https://thryftly.example
# Keys Qikink uses to push products, WooCommerce-style:
#   node -e "const r=n=>require('crypto').randomBytes(20).toString('hex');console.log('WOO_CONSUMER_KEY=ck_'+r()+'\nWOO_CONSUMER_SECRET=cs_'+r())"
WOO_CONSUMER_KEY=
WOO_CONSUMER_SECRET=
